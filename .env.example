# abdur.ai — environment variables
# Copy to .env.local and fill. Add to Vercel for production.

# ============== EMAIL (Resend) ==============
RESEND_API_KEY=
RESEND_AUDIENCE_TLDR=
RESEND_AUDIENCE_ASEC=
RESEND_AUDIENCE_MNEMIX=

# ============== AGENT WEBHOOKS ==============
# Generate with: openssl rand -hex 32
AGENT_TOKEN=

# ============== SUPABASE (Phase 2) ==============
# Both are used server-side only (raw PostgREST fetch in lib/supabase.ts).
# The service-role key bypasses RLS — never expose it to the client, despite
# the NEXT_PUBLIC_ name on the URL var (only the URL is public). The URL is
# inlined into the build at build time — changing it requires a rebuild.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ============== STRIPE (Phase 3, Library) ==============
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============== ANALYTICS ==============
# Vercel Web Analytics (@vercel/analytics) — no env var needed.
# Enable in the Vercel dashboard: project → Analytics → Enable.
# Script is served same-origin from /_vercel/insights/*.

# ============== OPS RECEIPTS (GMP -> ledger, W-4) ==============
# tldr:publish emits one content_publish receipt per publish to the Northsun
# ops_receipts ledger, keyed abdurai:content_publish:writing:<slug>.
# Shared internal ingest secret — store in Doppler / your shell; never commit.
MNEMIX_OPS_INGEST_KEY=
# Path to the Northsun receipt emitter script (default shown).
MNEMIX_RECEIPT_SCRIPT=~/Projects/Mnemix/scripts/ops/receipt.mjs
# Optional: MNEMIX_API_BASE overrides the ingest base URL (default https://mcp.mnemix.ai).
MNEMIX_API_BASE=
# Kill switch: set to 0 to skip receipt emission entirely.
MNEMIX_RECEIPT_EMIT=1
