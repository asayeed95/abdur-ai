# abdur.ai — environment variables
# Copy to .env.local and fill. Add to Vercel for production.

# ============== EMAIL (Resend) ==============
RESEND_API_KEY=
RESEND_AUDIENCE_TLDR=
RESEND_AUDIENCE_ASEC=
RESEND_AUDIENCE_MNEMIX=

# ============== AGENT WEBHOOKS ==============
# Generate with: openssl rand -hex 32
AGENT_TOKEN=

# ============== PUBLISH CORE (abdur-ai MCP server, /admin) ==============
# Fine-grained GitHub token: ONLY asayeed95/abdur-ai, Contents RW + Pull
# requests RW. Writes go to drafts/<slug> branches + draft PRs, never main.
# Unset = every write is a dry run. Keep it in Doppler; this repo is public.
ABDUR_PUBLISH_GITHUB_TOKEN=
# ABDUR_PUBLISH_REPO=asayeed95/abdur-ai
# Only directory abdur_upload_image may read local files from (symlinks
# resolved, size checked first). Default: the MCP server's working directory.
# ABDUR_PUBLISH_UPLOAD_DIR=

# ============== SUPABASE (Phase 2) ==============
# Both are used server-side only (raw PostgREST fetch in lib/supabase.ts).
# The service-role key bypasses RLS — never expose it to the client, despite
# the NEXT_PUBLIC_ name on the URL var (only the URL is public). The URL is
# inlined into the build at build time — changing it requires a rebuild.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ============== COMMUNITY (comments + votes, AGE-2972) ==============
# A SEPARATE Supabase project (`abdur-ai`, ref pzfbnnubapinhbnwqpnp, org
# AgencyFlow HQ) — not the northsun project above. Both values are public by
# design (publishable key); every rule is enforced by RLS + triggers in
# supabase/community/migrations/. Unset = posts with `comments: true` show
# "comments not available". Inlined at build time — rebuild after changing.
NEXT_PUBLIC_COMMUNITY_SUPABASE_URL=
NEXT_PUBLIC_COMMUNITY_SUPABASE_PUBLISHABLE_KEY=

# ============== ADMIN (/admin, AGE-2974) ==============
# Comma-separated emails allowed into /admin (server-side check). The same
# address must also be in the community DB's public.admins table for
# moderation — RLS is the second gate; the web server holds no service key.
ADMIN_EMAILS=

# ============== STRIPE (Phase 3, Library) ==============
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============== ANALYTICS ==============
# Vercel Web Analytics (@vercel/analytics) — no env var needed.
# Enable in the Vercel dashboard: project → Analytics → Enable.
# Script is served same-origin from /_vercel/insights/*.
